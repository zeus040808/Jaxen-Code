# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交。

# ---- DeepSeek（默认 provider）----
HH_DEEPSEEK_API_KEY=
HH_DEEPSEEK_API_BASE=https://api.deepseek.com
HH_DEEPSEEK_MODEL=deepseek-flash

# ---- 任意 OpenAI Chat Completions 兼容端点（--provider openai，可选）----
# 例如通义千问兼容模式：https://dashscope.aliyuncs.com/compatible-mode
# 不在内置表里的模型，用 --context-window 告诉 agent 它的窗口大小。
HH_OPENAI_API_KEY=
HH_OPENAI_API_BASE=
HH_OPENAI_MODEL=

# 额外需要脱敏的环境变量名，逗号分隔。
# 这些变量的值不会出现在 trace、report、session 或终端输出里。
HH_SECRET_ENV_NAMES=
