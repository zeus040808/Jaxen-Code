# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交。

# ---- DeepSeek（默认 provider）----
HH_DEEPSEEK_API_KEY=
HH_DEEPSEEK_API_BASE=https://api.deepseek.com
HH_DEEPSEEK_MODEL=deepseek-v4-pro

# ---- OpenAI 兼容后端（可选）----
HH_OPENAI_API_KEY=
HH_OPENAI_API_BASE=
HH_OPENAI_MODEL=

# ---- Anthropic 兼容后端（可选）----
HH_ANTHROPIC_API_KEY=
HH_ANTHROPIC_API_BASE=
HH_ANTHROPIC_MODEL=

# 额外需要脱敏的环境变量名，逗号分隔。
# 这些变量的值不会出现在 trace、report、session 或终端输出里。
HH_SECRET_ENV_NAMES=
